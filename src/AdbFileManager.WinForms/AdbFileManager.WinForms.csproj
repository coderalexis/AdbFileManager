  <Target Name="PreBuild" BeforeTargets="PrepareForBuild">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(ProjectDir)" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="CurrentGitCommit" />
    </Exec>
    <WriteLinesToFile File="$(ProjectDir)CurrentCommit.txt" Lines="$(CurrentGitCommit)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

