    <InternalsVisibleTo Include="AdbFileManager.UiChecks" />
    <ProjectReference Include="..\AdbFileManager.Infrastructure\AdbFileManager.Infrastructure.csproj" />
    <EmbeddedResource Update="Views\**\*.resx"><LogicalName>AdbFileManager.%(Filename).resources</LogicalName></EmbeddedResource>
    <EmbeddedResource Update="Controls\**\*.resx"><LogicalName>AdbFileManager.%(Filename).resources</LogicalName></EmbeddedResource>
